<Window x:Class="RoR2RenamingConvention.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoR2RenamingConvention"
        mc:Ignorable="d"
        Title="Risk of Rain 2 Renaming Convention" Height="450" Width="1200" ResizeMode="NoResize">
    <Grid >
        <Grid x:Name="ConventionGrid">
            <ListBox x:Name="DLCList" HorizontalAlignment="Left" Height="84" Margin="44,59,0,0" VerticalAlignment="Top" Width="188" d:ItemsSource="{d:SampleData ItemCount=5}" MouseLeftButtonUp="SelectDLC"/>
            <Label Content="Langauge File Name&#xD;&#xA;" HorizontalAlignment="Left" Margin="44,32,0,0" VerticalAlignment="Top" Height="27"/>
            <Image x:Name="IconImage" Margin="1055,46,40,332" Stretch="Fill"/>
            <Label x:Name="LanguageLabel" Content="Label" HorizontalAlignment="Left" Margin="1020,20,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.132,-0.037" HorizontalContentAlignment="Center" Width="139"/>
            <ListBox x:Name="LangItemList" HorizontalAlignment="Left" Height="232" Margin="44,165,0,0" VerticalAlignment="Top" Width="499" d:ItemsSource="{d:SampleData ItemCount=5}" MouseLeftButtonUp="SelectLangItem"/>
            <TextBox x:Name="CustomLanguage_Textbox" HorizontalAlignment="Left" Margin="660,165,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="185" Height="232"/>
            <Label Content="Custom Language" HorizontalAlignment="Left" Margin="660,134,0,0" VerticalAlignment="Top"/>
            <Label x:Name="OfficialLnguage_Label" Content="Original Language" HorizontalAlignment="Left" Margin="936,134,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="OfficialLnguage_Textbox" HorizontalAlignment="Left" Margin="936,165,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="185" Height="232" IsEnabled="False"/>
            <Button Content="Load Original&#xD;&#xA;Language" HorizontalAlignment="Left" Margin="277,63,0,0" VerticalAlignment="Top" Click="Click_LoadOriginalLanguage" Height="41" RenderTransformOrigin="0.5,0.5" Width="112" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="1.066"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button x:Name="UpdateCustomWithOriginal_Button" Content="Update custom &#xD;&#xA;with original" HorizontalAlignment="Left" Margin="415,63,0,0" VerticalAlignment="Top" Click="Click_UpdateCustomWithOriginal" Height="41" RenderTransformOrigin="0.5,0.5" Width="112" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="1.066"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <CheckBox x:Name="checkbox_untranslatedFilter" Content="Show only untranslated" HorizontalAlignment="Left" Margin="278,128,0,0" VerticalAlignment="Top" Checked="Click_FilterLangItems" Unchecked="Click_FilterLangItems"/>
            <CheckBox x:Name="checkbox_hideloredesc" Content="Hide Lore/Desc" HorizontalAlignment="Left" Margin="444,128,0,0" VerticalAlignment="Top" Checked="Click_FilterLangItems" Unchecked="Click_FilterLangItems"/>
        </Grid>
        <Grid x:Name="LoadGrid" IsEnabled="False" Visibility="Hidden">
            <Button Content="Load Custom Language" HorizontalAlignment="Center" Margin="0,282,0,0" VerticalAlignment="Top" Height="32" Width="150" Click="Click_LoadCustomLanguage" FontWeight="Bold" FontSize="13" FontFamily="Comic Sans MS"/>
            <Label Content="RoR 2 Renaming Convention" HorizontalAlignment="Center" Margin="0,91,0,0" VerticalAlignment="Top" FontFamily="Comic Sans MS" FontWeight="Bold" FontSize="36"/>

        </Grid>
    </Grid>

</Window>
